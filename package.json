{
  "name": "zip_upload",
  "description": "Drag a folder into Nextcloud, zip it client-side (store only) and upload it as a single file.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "webpack --config webpack.config.js --progress --node-env production",
    "dev": "webpack --config webpack.config.js --progress --node-env development",
    "watch": "webpack --config webpack.config.js --progress --watch --node-env development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "@playwright/test": "^1.47.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0",
    "jest": "^29.7.0",
    "terser-webpack-plugin": "^5.6.1"
  },
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  }
}
